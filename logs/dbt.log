  create temporary table "fct_activity__dbt_tmp162634046683"
  
  
    as
  
  (
    

-- merge strategy chosen over append because activities can be updated after creation
-- (e.g. done flipping from false to true). merge ensures existing records are kept accurate
-- while avoiding a full table rebuild on every run.

-- note: in a BigQuery environment this model would be partitioned by due_to
-- and clustered by deal_id for query performance. omitted here as Postgres
-- does not support these configs natively through dbt.

with ranked_activity as (
    select
        *,
        row_number() over (partition by activity_id order by due_to desc) as rn
    from "postgres"."public_pipedrive_analytics"."stg_activity"
),

deduped_activity as (
    -- the >= incremental filter can re-pull activity_ids already loaded in a previous run.
    -- deduplication here ensures the merge operates on one row per activity_id,
    -- preventing unique key violations in the final table.
    select * from ranked_activity
    where rn = 1
)

select
    deduped_activity.activity_id,
    deduped_activity.deal_id,
    deduped_activity.assigned_to_user,
    activity_types.activity_type_id,
    activity_types.activity_type_name,
    activity_types.activity_type_key,
    activity_types.is_active         as is_activity_type_active,
    deduped_activity.done,
    deduped_activity.due_to
from deduped_activity
-- simple lookup join; if logic were more complex an intermediate model would be introduced first
left join "postgres"."public_pipedrive_analytics"."stg_activity_types" activity_types
    on deduped_activity.activity_type_key = activity_types.activity_type_key


    where deduped_activity.due_to >= (select max(due_to) from "postgres"."public_pipedrive_analytics"."fct_activity")

  );
  
  
